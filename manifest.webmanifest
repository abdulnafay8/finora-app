{
  "name": "Finora",
  "short_name": "Finora",
  "description": "Every account, currency and budget in one calm, private place.",
  "id": "/finora-app/",
  "start_url": "/finora-app/",
  "scope": "/finora-app/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0C1310",
  "theme_color": "#1F4D3A",
  "categories": [
    "finance",
    "productivity"
  ],
  "icons": [
    {
      "src": "/finora-app/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/finora-app/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/finora-app/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/finora-app/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text"
    }
  }
}
